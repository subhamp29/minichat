# MiniChat Environment Variables
# Copy this file to .env and fill in your actual values.

# Groq API key (primary LLM provider)
GROQ_API_KEY=<your-groq-api-key>

# Gemini API key (fallback LLM provider)
GEMINI_API_KEY=<your-gemini-api-key>

# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/service_role key
SUPABASE_KEY=<your-supabase-key>

# n8n webhook endpoint
N8N_WEBHOOK_URL=http://localhost:5678/webhook/chat

# n8n server port
N8N_PORT=5678

# Supabase port (if using local Supabase)
SUPABASE_PORT=5432

# Default model key (must match a key in MODEL_OPTIONS)
DEFAULT_MODEL_KEY=Qwen2.5 0.5B (Q4_K_M) - Ultra Fast

# Hugging Face cache directory
HF_HOME=.model_cache
